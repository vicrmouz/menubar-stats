<Window x:Class="MenuBarStats.Windows.TaskbarWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MenuBarStats" Width="148" Height="28" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="{DynamicResource Surface}" PreviewKeyDown="LabelKeyDown" MouseLeftButtonDown="DragStarted" MouseMove="DragMoved" MouseLeftButtonUp="DragEnded" LostMouseCapture="DragCancelled">
 <Border Padding="5,0" Background="{DynamicResource Surface}" CornerRadius="4" ToolTip="CPU e memória · clique para abrir · arraste para reposicionar" Focusable="True" AutomationProperties.Name="CPU e memória. Abrir painel MenuBarStats">
 <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
 <Viewbox Width="14" Height="14" Margin="0,0,4,0"><Path Stroke="{DynamicResource Foreground}" StrokeThickness="1.25" Data="M4,4 H12 V12 H4 Z M6,6 H10 V10 H6 Z M6,1 V4 M10,1 V4 M6,12 V15 M10,12 V15 M1,6 H4 M1,10 H4 M12,6 H15 M12,10 H15"/></Viewbox>
 <TextBlock Text="{Binding CpuLabel}" FontSize="13" FontWeight="Medium" Typography.NumeralAlignment="Tabular" MinWidth="31"/>
 <Viewbox Width="16" Height="12" Margin="8,0,4,0"><Path Stroke="{DynamicResource Foreground}" StrokeThickness="1.25" Data="M1,2 H17 V10 H1 Z M4,4 H7 V7 H4 Z M10,4 H13 V7 H10 Z M4,10 V13 M7,10 V13 M10,10 V13 M13,10 V13"/></Viewbox>
 <TextBlock Text="{Binding MemoryLabel}" FontSize="13" FontWeight="Medium" Typography.NumeralAlignment="Tabular" MinWidth="31"/>
 </StackPanel></Viewbox></Border>
</Window>
